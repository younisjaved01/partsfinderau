# PARTS IQ — server-side environment (never committed with real values).
# Copy this file to `.env` and fill in your key. `.env` is git-ignored.
#
# The OpenAI API key is used ONLY on the server (Vite dev middleware /
# server.mjs). It is never exposed to the browser bundle. Do NOT prefix it
# with VITE_ (that would expose it to the client).

# Your OpenAI API key (leave blank to run in Demo Mode / offline mock).
OPENAI_API_KEY=

# Model to use for request understanding (any current OpenAI model that
# supports the Responses API + structured outputs). Optional.
OPENAI_MODEL=gpt-4o-mini

# Force a provider: "openai" or "mock". Optional — defaults to "openai" when
# OPENAI_API_KEY is set, otherwise "mock".
LLM_PROVIDER=

# Production server port (server.mjs). Optional — defaults to 4173.
PORT=4173
